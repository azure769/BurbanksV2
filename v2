local function createDropdownPopup(section, selectBox, hasSearch)
	local window = section.library
	local popup = create("Frame", {
		Parent = window.container,
		Size = UDim2.fromOffset(190, 176),
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		Visible = false,
		ClipsDescendants = true,
		ZIndex = 420,
	})
	bindTheme(window, popup, "BackgroundColor3", "Card")
	corner(popup, 8)
	local popupStroke = stroke(popup, window.theme.Stroke, 0.45, 1)
	bindTheme(window, popupStroke, "Color", "Stroke")

	local search
	local listY = 8
	local listHeight = 160

	if hasSearch ~= false then
		search = create("TextBox", {
			Parent = popup,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 0, 28),
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			PlaceholderText = "Search...",
			Text = "",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 422,
		})
		bindTheme(window, search, "BackgroundColor3", "Background2")
		bindTheme(window, search, "TextColor3", "Text")
		bindTheme(window, search, "PlaceholderColor3", "Muted")
		search.TextTransparency = 0.15
		corner(search, 5)
		padding(search, 9, 8, 0, 0)
		listY = 43
		listHeight = 125
	end

	local list = create("ScrollingFrame", {
		Parent = popup,
		Position = UDim2.fromOffset(6, listY),
		Size = UDim2.new(1, -12, 0, listHeight),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 2,
		ScrollBarImageTransparency = 0.45,
		ZIndex = 421,
	})
	bindTheme(window, list, "ScrollBarImageColor3", "Accent")

	local layout = create("UIListLayout", {
		Parent = list,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
	})
	refreshCanvas(list, layout, 6)

	local function positionPopup()
		if not popup.Parent or not selectBox.Parent then return end

		local absPos = selectBox.AbsolutePosition
		local absSize = selectBox.AbsoluteSize
		local camera = Workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)

		local width = math.max(170, math.min(220, absSize.X + 50))
		local height = popup.Size.Y.Offset
		local x = absPos.X + absSize.X - width
		local y = absPos.Y + absSize.Y + 5

		if x < 8 then x = 8 end
		if x + width > viewport.X - 8 then x = viewport.X - width - 8 end
		if y + height > viewport.Y - 8 then y = absPos.Y - height - 5 end
		if y < 8 then y = 8 end

		popup.Position = UDim2.fromOffset(x, y)
		popup.Size = UDim2.fromOffset(width, height)
	end

	local connection = RunService.RenderStepped:Connect(function()
		if popup.Visible then positionPopup() end
	end)
	window._connections[#window._connections + 1] = connection

	return popup, search, list, positionPopup
end

function Section:addDropdown(data)
	data = data or {}
	local options = {
		title = tostring(data.title or data.Title or "DROPDOWN"),
		list = {},
		selected = data.default or data.Default or data.selected or data.Selected,
		callback = data.callback or data.Callback or function() end,
	}
	for _, value in ipairs(data.list or data.List or {}) do
		options.list[#options.list + 1] = tostring(value)
	end

	local module = createBoxedModule(self, 32)
	module.ClipsDescendants = false

	local infoText = getInfoText(data)
	local title = createBoxedTitle(self, module, options.title, infoText and 188 or 158)
	createInfoHint(self, module, infoText, 156)

	local selectBox = create("TextButton", {
		Parent = module,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, infoText and -34 or -10, 0.5, 0),
		Size = UDim2.fromOffset(126, 22),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	})
	bindTheme(self.library, selectBox, "BackgroundColor3", "Background2")
	selectBox.BackgroundTransparency = 0.28
	corner(selectBox, 5)
	local selectStroke = stroke(selectBox, self.library.theme.Stroke, 0.58, 1)
	bindTheme(self.library, selectStroke, "Color", "Stroke")

	local selectedLabel = createLabel(
		self.library,
		selectBox,
		options.selected and tostring(options.selected) or "Select",
		10,
		Enum.Font.GothamMedium
	)
	selectedLabel.Position = UDim2.fromOffset(8, 0)
	selectedLabel.Size = UDim2.new(1, -29, 1, 0)
	selectedLabel.TextTransparency = 0.28
	selectedLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local arrow = createLucideIcon(self.library, selectBox, "chevron-down", 13, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(13, 13),
		ZIndex = 8,
	}, "Muted")
	arrow.ImageTransparency = 0.18

	local popup, search, list, positionPopup = createDropdownPopup(self, selectBox, true)
	local opened = false

	local function setOpen(state)
		opened = state == true
		popup.Visible = opened
		tween(arrow, 0.15, {
			Rotation = opened and 180 or 0,
			ImageTransparency = opened and 0 or 0.18,
		})
		if opened then
			positionPopup()
			search.Text = ""
			task.defer(function()
				if search and search.Parent then search:CaptureFocus() end
			end)
		end
	end

	local function clearEntries()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
	end

	local function rebuild(filter)
		clearEntries()
		filter = string.lower(tostring(filter or ""))

		for _, value in ipairs(options.list) do
			if filter == "" or string.find(string.lower(value), filter, 1, true) then
				local isSelected = tostring(options.selected or "") == value

				local entry = create("TextButton", {
					Parent = list,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundTransparency = isSelected and 0.66 or 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 423,
				})
				bindTheme(self.library, entry, "BackgroundColor3", "Card2")
				corner(entry, 5)

				local entryText = createLabel(self.library, entry, value, 11, Enum.Font.GothamMedium)
				entryText.Position = UDim2.fromOffset(9, 0)
				entryText.Size = UDim2.new(1, -34, 1, 0)
				entryText.TextTransparency = isSelected and 0.05 or 0.40
				entryText.ZIndex = 424

				if isSelected then
					local check = createLucideIcon(self.library, entry, "check", 13, {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -8, 0.5, 0),
						Size = UDim2.fromOffset(13, 13),
						ZIndex = 424,
					}, "Accent")
					check.ImageTransparency = 0
				end

				entry.MouseEnter:Connect(function()
					tween(entry, 0.12, { BackgroundTransparency = 0.62 })
					tween(entryText, 0.12, { TextTransparency = 0.08 })
				end)
				entry.MouseLeave:Connect(function()
					tween(entry, 0.12, { BackgroundTransparency = isSelected and 0.66 or 1 })
					tween(entryText, 0.12, { TextTransparency = isSelected and 0.05 or 0.40 })
				end)

				entry.MouseButton1Click:Connect(function()
					options.selected = value
					selectedLabel.Text = value
					setOpen(false)
					rebuild("")
					safeCall(options.callback, value)
				end)
			end
		end
	end

	selectBox.MouseEnter:Connect(function()
		tween(selectBox, 0.12, { BackgroundTransparency = 0.12 })
	end)
	selectBox.MouseLeave:Connect(function()
		if not opened then tween(selectBox, 0.12, { BackgroundTransparency = 0.28 }) end
	end)
	selectBox.MouseButton1Click:Connect(function()
		setOpen(not opened)
		if opened then rebuild("") end
	end)

	search:GetPropertyChangedSignal("Text"):Connect(function()
		if opened then rebuild(search.Text) end
	end)

	rebuild("")

	local controller = { Instance = module, Options = options }
	function controller:Set(value, callCallback)
		value = tostring(value)
		options.selected = value
		selectedLabel.Text = value
		rebuild(search.Text)
		if callCallback ~= false then safeCall(options.callback, value) end
		return self
	end
	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil or newOptions.Title ~= nil then
			options.title = tostring(newOptions.title or newOptions.Title)
			title.Text = options.title
		end

		local newList = newOptions.list or newOptions.List
		if typeof(newList) == "table" then
			table.clear(options.list)
