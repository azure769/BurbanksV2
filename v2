function Section:addToggle(data)
    data=data or {}
    local options={
        title=tostring(data.title or data.Title or "TOGGLE"),
        toggled=data.default==true or data.toggled==true,
        callback=data.callback or data.Callback or function() end,
    }
    local module=createBoxedModule(self,38)
    local button=create("TextButton",{Parent=module,Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",AutoButtonColor=false})
    local infoText=getInfoText(data)
    local title=createBoxedTitle(self, button, options.title, infoText and 118 or 70)
    createInfoHint(self, button, infoText, 66)

    -- NeverLose toggle pill
    local track=create("Frame",{
        Parent=button, AnchorPoint=Vector2.new(1,0.5),
        Position=UDim2.new(1,infoText and -34 or -12,0.5,0),
        Size=UDim2.fromOffset(30,18), BorderSizePixel=0,
    })
    bindTheme(self.library, track, "BackgroundColor3", "Background2")
    corner(track,9)
    local trackStroke=stroke_ui(track, self.library.theme.Stroke, 0.5, 1)
    bindTheme(self.library, trackStroke, "Color", "Stroke")

    local knob=create("Frame",{
        Parent=track, AnchorPoint=Vector2.new(0.5,0.5),
        Size=UDim2.fromOffset(16,16), BorderSizePixel=0,
    })
    corner(knob,10)

    local function refresh(animated)
        local position=options.toggled and UDim2.new(0.7,0,0.5,0) or UDim2.new(0.3,0,0.5,0)
        local color=options.toggled and self.library.theme.Accent or Color3.fromRGB(255,255,255)
        local knobTransparency=options.toggled and 0 or 0.5
        if animated then
            NeverLose.PlayAnimate(knob, SlowyTween, {Position=position, BackgroundColor3=color, BackgroundTransparency=knobTransparency})
            NeverLose.PlayAnimate(track, SlowyTween, {BackgroundColor3=options.toggled and NeverLose.AccentColor or Color3.fromRGB(10,13,21)})
        else
            knob.Position=position; knob.BackgroundColor3=color; knob.BackgroundTransparency=knobTransparency
            track.BackgroundColor3=options.toggled and NeverLose.AccentColor or Color3.fromRGB(10,13,21)
        end
    end

    bindThemeRefresh(self.library, function() refresh(false) end)
    button.MouseButton1Click:Connect(function()
        options.toggled=not options.toggled; refresh(true); safeCall(options.callback, options.toggled)
    end)

    local controller={Instance=module,Options=options}
    function controller:Set(value, callCallback)
        options.toggled=value==true; refresh(true)
        if callCallback~=false then safeCall(options.callback, options.toggled) end
        return self
    end
    function controller:Update(newOptions)
        newOptions=newOptions or {}
        if newOptions.title~=nil then options.title=tostring(newOptions.title); title.Text=options.title end
        if newOptions.default~=nil then self:Set(newOptions.default,false)
        elseif newOptions.toggled~=nil then self:Set(newOptions.toggled,false) end
        if typeof(newOptions.callback)=="function" then options.callback=newOptions.callback end
        return self
    end
    self.modules[#self.modules+1]=controller
    return controller
end
