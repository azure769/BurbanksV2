		local function validateKey(candidate)
			if typeof(self.keyValidate) == "function" then
				local ok, result = pcall(self.keyValidate, candidate, self)
				return ok and result == true
			end
			return candidate == self.keyValue
		end

		local function rememberKey(candidate)
			if not self.keyRemember then return end
			if typeof(writefile) == "function" then pcall(writefile, self.keyFileName, candidate) end
		end

		local function animateMainFromKey()
			if not self.main or not self.main.Parent then return end
			self.main.Visible = true
			local finalPosition = UDim2.fromScale(0.5, 0.5)
			local finalTransparency = 0.055
			self.main.Position = UDim2.new(0.5, 0, 0.5, 16)
			self.main.BackgroundTransparency = 1
			self.startupScale.Scale = math.max(0.5, self.uiScale * 0.9)
			tween(self.main, self.startupDuration, { Position = finalPosition, BackgroundTransparency = finalTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			tween(self.startupScale, self.startupDuration, { Scale = self.uiScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			self.openPosition = finalPosition
			self.openSize = self.main.Size
		end

		local function submitKey()
			local candidate = tostring(keyInput.Text or ""):match("^%s*(.-)%s*$")
			if candidate == "" then
				keyStatus.Text = "Enter a key first."
				bindTheme(self, keyStatus, "TextColor3", "Danger")
				return
			end
			if validateKey(candidate) then
				self.keyVerified = true
				rememberKey(candidate)
				keyStatus.Text = "Access granted."
				bindTheme(self, keyStatus, "TextColor3", "Accent")
				tween(keyCardScale, 0.2, { Scale = 0.94 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				task.wait(0.16)
				if keyOverlay and keyOverlay.Parent then keyOverlay:Destroy() end
				animateMainFromKey()
			else
				keyStatus.Text = "Invalid key. Try again."
				bindTheme(self, keyStatus, "TextColor3", "Danger")
				tween(keyCard, 0.06, { Position = UDim2.new(0.5, -7, 0.5, 0) })
				task.delay(0.07, function()
					if keyCard and keyCard.Parent then tween(keyCard, 0.08, { Position = UDim2.fromScale(0.5, 0.5) }) end
				end)
			end
		end

		verifyButton.MouseButton1Click:Connect(submitKey)
		keyInput.FocusLost:Connect(function(enterPressed) if enterPressed then submitKey() end end)

		if self.keyRemember and typeof(readfile) == "function" and typeof(isfile) == "function" then
			local ok, saved = pcall(function()
				if isfile(self.keyFileName) then return readfile(self.keyFileName) end
			end)
			if ok and saved and validateKey(tostring(saved)) then
				self.keyVerified = true
				keyOverlay.Visible = false
			end
		end
	end

