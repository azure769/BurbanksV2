function Library:addPage(data)
    data=data or {}
    local page=setmetatable({},Page)
    page.library=self; page.title=tostring(data.title or data.Title or "PAGE"); page.sections={}; page._columns={}

    -- NeverLose tab button
    local button = create("TextButton",{
        Parent=self.pagesContainer, Size=UDim2.new(1,-1,0,30),
        BackgroundTransparency=1, BorderSizePixel=0, Text="", AutoButtonColor=false,
    })
    local background = create("Frame",{
        Parent=button, Size=UDim2.new(1,-1,1,0),
        BorderSizePixel=0, BackgroundTransparency=1,
    })
    bindTheme(self, background, "BackgroundColor3", "Card")
    corner(background,6)

    local iconName=data.icon or data.Icon
    local fallbackIconText=tostring(data.iconText or data.IconText or "◆")
    local icon

    if iconName~=nil then
        local iconValue=tostring(iconName)
        if iconValue:match("^rbxassetid://") or iconValue:match("^https?://") or tonumber(iconValue) then
            local imageUrl=tonumber(iconValue) and ("rbxassetid://"..iconValue) or iconValue
            icon=create("ImageLabel",{
                Parent=background, BackgroundTransparency=1,
                Position=UDim2.fromOffset(2,3), Size=UDim2.fromOffset(25,25),
                Image=imageUrl, ScaleType=Enum.ScaleType.Fit,
            })
            bindTheme(self, icon, "ImageColor3", "Muted")
        else
            -- NeverLose BuiltIn icon system
            icon=createLabel(self, background, iconValue, 16, Enum.Font.GothamMedium)
            icon.FontFace=NeverLose.BuiltInBold
            icon.Position=UDim2.fromOffset(2,0); icon.Size=UDim2.fromOffset(25,30)
            icon.TextXAlignment=Enum.TextXAlignment.Center
            bindTheme(self, icon, "TextColor3", "Muted")
        end
    end

    if not icon then
        icon=createLabel(self, background, fallbackIconText, 12, Enum.Font.GothamBold)
        icon.Position=UDim2.fromOffset(2,0); icon.Size=UDim2.fromOffset(25,30)
        icon.TextXAlignment=Enum.TextXAlignment.Center
        bindTheme(self, icon, "TextColor3", "Muted")
    end

    local title=createLabel(self, background, page.title, 12, Enum.Font.GothamMedium)
    title.Position=UDim2.fromOffset(30,0); title.Size=UDim2.new(1,-37,1,0)
    bindTheme(self, title, "TextColor3", "Muted"); title.TextTransparency=0.35

    -- Page content container
    local pageContainer=create("Frame",{
        Name="PageContainer", Parent=self.content,
        Position=UDim2.fromOffset(0,50), Size=UDim2.new(1,0,1,-50),
        BackgroundTransparency=1, Visible=false,
    })

    local function makeColumn(name, pos, size)
        local sf=create("ScrollingFrame",{
            Name=name, Parent=pageContainer, Size=size, Position=pos,
            BackgroundTransparency=1, BorderSizePixel=0, CanvasSize=UDim2.new(), ScrollBarThickness=0,
        })
        bindTheme(self, sf, "ScrollBarImageColor3", "Accent")
        local layout=create("UIListLayout",{Parent=sf, SortOrder=Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,5)})
        refreshCanvas(sf, layout, 12)
        return sf
    end

    local leftColumn  = makeColumn("LeftColumn",  UDim2.fromOffset(0,0),     UDim2.new(0.5,0,1,-5))
    local rightColumn = makeColumn("RightColumn",  UDim2.new(0.5,0,0,0),     UDim2.new(0.5,0,1,-5))
    local fullColumn  = makeColumn("FullColumn",   UDim2.fromOffset(0,0),     UDim2.new(1,0,1,0))
    fullColumn.Visible=false

    page._columns={left=leftColumn, right=rightColumn, full=fullColumn}
    page.container=pageContainer; page.button=button; page.background=background; page.icon=icon; page.buttonTitle=title

    self.pages[#self.pages+1]=page
    button.LayoutOrder=#self.pages

    self:_applyPageLayout(page, self._mobileMode)
    if self.sidebarCollapsed then
        title.Visible=false
        if icon:IsA("ImageLabel") or icon:IsA("ImageButton") then
            icon.Position=UDim2.fromOffset(18,7)
        else
            icon.Position=UDim2.fromOffset(14,0)
        end
    end

    button.MouseEnter:Connect(function()
        if self.focusedPage~=page then tween_ui(background,0.15,{BackgroundTransparency=0.8}) end
    end)
    button.MouseLeave:Connect(function()
        if self.focusedPage~=page then tween_ui(background,0.15,{BackgroundTransparency=1}) end
    end)
    button.MouseButton1Click:Connect(function() self:SelectPage({page=page}) end)

    bindThemeRefresh(self, function()
        local selected=self.focusedPage==page
        page.buttonTitle.TextColor3=selected and self.theme.Text or self.theme.Muted
        page.buttonTitle.TextTransparency=selected and 0 or 0.5
        if page.icon:IsA("ImageLabel") or page.icon:IsA("ImageButton") then
            page.icon.ImageColor3=selected and self.theme.Accent or self.theme.Muted
        else
            page.icon.TextColor3=selected and self.theme.Accent or self.theme.Muted
            page.icon.TextTransparency=selected and 0 or 0.5
        end
    end)

    if #self.pages==1 then self:SelectPage({page=page}) end
    return page
end
