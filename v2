	transparencyValue.AnchorPoint = Vector2.new(1, 0)
	transparencyValue.Position = UDim2.new(1, 0, 0, 37)
	transparencyValue.Size = UDim2.fromOffset(42, 18)
	transparencyValue.TextXAlignment = Enum.TextXAlignment.Right
	bindTheme(self.library, transparencyValue, "TextColor3", "Muted")
