function Section:addMultiDropdown(data)
	data = data or {}
	local options = {
		title = tostring(data.title or data.Title or "MULTI DROPDOWN"),
		list = {},
		selected = {},
		callback = data.callback or data.Callback or function() end,
		max = tonumber(data.max or data.Max),
	}

	for _, value in ipairs(data.list or data.List or {}) do
		options.list[#options.list + 1] = tostring(value)
	end

	local defaults = data.default or data.Default or data.selected or data.Selected or {}
	if typeof(defaults) ~= "table" then defaults = {defaults} end
	for _, value in ipairs(defaults) do
		local stringValue = tostring(value)
		if table.find(options.list, stringValue) and not table.find(options.selected, stringValue) then
			options.selected[#options.selected + 1] = stringValue
		end
	end

	local module = createBoxedModule(self, 32)
	module.ClipsDescendants = false

	local infoText = getInfoText(data)
	local title = createBoxedTitle(self, module, options.title, infoText and 188 or 158)
	createInfoHint(self, module, infoText, 156)

	local selectBox = create("TextButton", {
		Parent = module,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, infoText and -34 or -10, 0.5, 0),
		Size = UDim2.fromOffset(126, 22),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	})
	bindTheme(self.library, selectBox, "BackgroundColor3", "Background2")
	selectBox.BackgroundTransparency = 0.28
	corner(selectBox, 5)
	local selectStroke = stroke(selectBox, self.library.theme.Stroke, 0.58, 1)
	bindTheme(self.library, selectStroke, "Color", "Stroke")

	local selectedLabel = createLabel(self.library, selectBox, "", 10, Enum.Font.GothamMedium)
	selectedLabel.Position = UDim2.fromOffset(8, 0)
	selectedLabel.Size = UDim2.new(1, -29, 1, 0)
	selectedLabel.TextTransparency = 0.28
	selectedLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local arrow = createLucideIcon(self.library, selectBox, "chevron-down", 13, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(13, 13),
		ZIndex = 8,
	}, "Muted")
	arrow.ImageTransparency = 0.18

	local popup, search, list, positionPopup = createDropdownPopup(self, selectBox, true)

	local function copySelected()
		local result = {}
		for i, value in ipairs(options.selected) do result[i] = value end
		return result
	end

	local function updateTitle()
		if #options.selected == 0 then
			selectedLabel.Text = "Select"
		elseif #options.selected == 1 then
			selectedLabel.Text = options.selected[1]
		else
			selectedLabel.Text = ("%d selected"):format(#options.selected)
		end
	end

	local opened = false
	local function setOpen(state)
		opened = state == true
		popup.Visible = opened
		tween(arrow, 0.15, {
			Rotation = opened and 180 or 0,
			ImageTransparency = opened and 0 or 0.18,
		})
		if opened then
			positionPopup()
			search.Text = ""
			task.defer(function()
				if search and search.Parent then search:CaptureFocus() end
			end)
		end
	end

	local function clearEntries()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
	end

	local rebuild
	rebuild = function(filter)
		clearEntries()
		filter = string.lower(tostring(filter or ""))

		for _, value in ipairs(options.list) do
			if filter == "" or string.find(string.lower(value), filter, 1, true) then
				local isSelected = table.find(options.selected, value) ~= nil

				local entry = create("TextButton", {
					Parent = list,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundTransparency = isSelected and 0.66 or 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 423,
				})
				bindTheme(self.library, entry, "BackgroundColor3", "Card2")
				corner(entry, 5)

				local checkBox = create("Frame", {
					Parent = entry,
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 8, 0.5, 0),
					Size = UDim2.fromOffset(16, 16),
					BorderSizePixel = 0,
					BackgroundTransparency = isSelected and 0 or 0.70,
					ZIndex = 424,
				})
				bindTheme(self.library, checkBox, "BackgroundColor3", isSelected and "Accent" or "Background2")
				corner(checkBox, 4)

				if isSelected then
					local check = createLucideIcon(self.library, checkBox, "check", 11, {
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.fromScale(0.5, 0.5),
						Size = UDim2.fromOffset(11, 11),
						ZIndex = 425,
					}, "Text")
					check.ImageTransparency = 0
				end

				local entryText = createLabel(self.library, entry, value, 11, Enum.Font.GothamMedium)
				entryText.Position = UDim2.fromOffset(32, 0)
				entryText.Size = UDim2.new(1, -40, 1, 0)
				entryText.TextTransparency = isSelected and 0.05 or 0.40
				entryText.ZIndex = 424

				entry.MouseEnter:Connect(function()
					tween(entry, 0.12, { BackgroundTransparency = 0.62 })
					tween(entryText, 0.12, { TextTransparency = 0.08 })
				end)
				entry.MouseLeave:Connect(function()
					tween(entry, 0.12, { BackgroundTransparency = isSelected and 0.66 or 1 })
					tween(entryText, 0.12, { TextTransparency = isSelected and 0.05 or 0.40 })
				end)

				entry.MouseButton1Click:Connect(function()
					local index = table.find(options.selected, value)
					if index then
						table.remove(options.selected, index)
					else
						if options.max and #options.selected >= options.max then return end
						options.selected[#options.selected + 1] = value
					end

					updateTitle()
					rebuild(search.Text)
					safeCall(options.callback, copySelected(), value)
				end)
			end
		end
	end

	selectBox.MouseEnter:Connect(function()
		tween(selectBox, 0.12, { BackgroundTransparency = 0.12 })
	end)
	selectBox.MouseLeave:Connect(function()
		if not opened then tween(selectBox, 0.12, { BackgroundTransparency = 0.28 }) end
	end)
	selectBox.MouseButton1Click:Connect(function()
		setOpen(not opened)
		if opened then rebuild("") end
	end)

	search:GetPropertyChangedSignal("Text"):Connect(function()
		if opened then rebuild(search.Text) end
	end)

	updateTitle()
	rebuild("")

	local controller = { Instance = module, Options = options }
	function controller:Get() return copySelected() end
	function controller:Set(values, callCallback)
		if typeof(values) ~= "table" then values = {values} end
		table.clear(options.selected)

		for _, value in ipairs(values) do
			local stringValue = tostring(value)
			if table.find(options.list, stringValue) then
				options.selected[#options.selected + 1] = stringValue
			end
		end

		updateTitle()
		rebuild(search.Text)

		if callCallback ~= false then
			safeCall(options.callback, copySelected())
		end
		return self
	end
	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil or newOptions.Title ~= nil then
			options.title = tostring(newOptions.title or newOptions.Title)
			title.Text = options.title
		end

		local newList = newOptions.list or newOptions.List
		if typeof(newList) == "table" then
			table.clear(options.list)
			for _, value in ipairs(newList) do
				options.list[#options.list + 1] = tostring(value)
			end
			rebuild(search.Text)
		end

		if newOptions.max ~= nil or newOptions.Max ~= nil then
			options.max = tonumber(newOptions.max or newOptions.Max)
		end

		local selected = newOptions.default or newOptions.Default or newOptions.selected or newOptions.Selected
		if selected ~= nil then self:Set(selected, false) end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		elseif typeof(newOptions.Callback) == "function" then
			options.callback = newOptions.Callback
		end

		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end
