function Library:SetSidebarCollapsed(state)
	self.sidebarCollapsed = state == true
	if not self.sidebar or not self.content then return self end

	local sidebarWidth = self.sidebarCollapsed and 58 or 175
	tween(self.sidebar, 0.18, { Size = UDim2.new(0, sidebarWidth, 1, 0) })

	-- IMPORTANT:
	-- Desktop page geometry is locked to the 176px NeverLose content rail.
	-- Collapsing the sidebar changes ONLY the sidebar visuals, never the page origin.
	-- On mobile the rail moves beside the compact 58px sidebar.
	local contentX = self._mobileMode and 59 or 176
	tween(self.content, 0.18, {
		Position = UDim2.fromOffset(contentX, 0),
		Size = UDim2.new(1, -contentX, 1, 0),
	})

	if self.navigationLabel then self.navigationLabel.Visible = false end
	if self.playerProfile then self.playerProfile.Visible = not self.sidebarCollapsed end
	if self.playerProfileDivider then self.playerProfileDivider.Visible = not self.sidebarCollapsed end
	if self.sidebarCollapseIcon then
		tween(self.sidebarCollapseIcon, 0.18, { Rotation = self.sidebarCollapsed and 180 or 0 })
	end

	if self.titleLabel then self.titleLabel.Visible = not self.sidebarCollapsed end
	if self.subtitleLabel then self.subtitleLabel.Visible = not self.sidebarCollapsed end

	if self.logoImage then
		self.logoImage.AnchorPoint = Vector2.new(0, 0.5)
		self.logoImage.Position = self.sidebarCollapsed
			and UDim2.new(0, 20, 0.5, 0)
			or UDim2.new(0, 10, 0.5, 0)
	end
	if self.logoText then
		self.logoText.Position = self.sidebarCollapsed
			and UDim2.new(0, 12, 0.5, -17)
			or UDim2.new(0, 10, 0.5, -17)
	end

	for _, page in ipairs(self.pages) do
		if page.buttonTitle then
			page.buttonTitle.Visible = not self.sidebarCollapsed
		end
		if page.icon then
			page.icon.AnchorPoint = Vector2.new(0, 0.5)
			page.icon.Position = self.sidebarCollapsed
				and UDim2.new(0, 20, 0.5, 0)
				or UDim2.new(0, 7, 0.5, 0)
		end
	end

	for _, page in ipairs(self.pages) do
		self:_applyPageLayout(page, self._mobileMode)
	end

	return self
end
