function Library:_applyPageLayout(page, mobile)
	if not page or not page._columns then return end

	local left = page._columns.left
	local right = page._columns.right
	local full = page._columns.full
	if not left or not right or not full then return end

	local sections = page.sections or {}
	local sectionCount = #sections

	-- Reset all columns to a known state before laying anything out.
	left.AnchorPoint = Vector2.new(0, 0)
	right.AnchorPoint = Vector2.new(0, 0)
	full.AnchorPoint = Vector2.new(0, 0)

	if mobile then
		-- Mobile: one vertical page rail. Sections preserve their requested column,
		-- but left/right columns become stacked halves.
		full.Visible = false
		left.Visible = true
		right.Visible = true

		if sectionCount <= 1 then
			local only = sections[1]
			if only and only.column == "right" then
				left.Visible = false
				right.Position = UDim2.fromOffset(0, 0)
				right.Size = UDim2.fromScale(1, 1)
			else
				right.Visible = false
				left.Position = UDim2.fromOffset(0, 0)
				left.Size = UDim2.fromScale(1, 1)
			end
		else
			left.Position = UDim2.fromOffset(0, 0)
			left.Size = UDim2.new(1, 0, 0.5, -4)
			right.Position = UDim2.new(0, 0, 0.5, 4)
			right.Size = UDim2.new(1, 0, 0.5, -4)
		end

		for _, section in ipairs(sections) do
			if section.column == "full" then
				section.column = "left"
				if section.container and section.container.Parent ~= left then
					section.container.Parent = left
				end
			end
		end
		return
	end

	-- DESKTOP:
	-- Pages are always inside the fixed right content rail.
	-- Never use AnchorPoint 0.5 here because that can visually drift beneath
	-- the sidebar when the parent size changes.
	local GAP = 8
	full.Visible = false

	-- A single section should use the full available page width.
	if sectionCount <= 1 then
		local only = sections[1]
		left.Visible = false
		right.Visible = false
		full.Visible = true

		if only and only.container and only.container.Parent ~= full then
			only.container.Parent = full
		end

		full.Position = UDim2.fromOffset(0, 0)
		full.Size = UDim2.fromScale(1, 1)
		return
	end

	-- Multiple sections: strict two-column grid.
	left.Visible = true
	right.Visible = true

	left.Position = UDim2.fromOffset(0, 0)
	left.Size = UDim2.new(0.5, -(GAP / 2), 1, 0)

	right.Position = UDim2.new(0.5, GAP / 2, 0, 0)
	right.Size = UDim2.new(0.5, -(GAP / 2), 1, 0)

	-- "full" sections are laid into the left/right grid instead of forcing
	-- every other section into one huge full column.
	local nextAutoColumn = "left"
	for _, section in ipairs(sections) do
		local targetColumn = section.column

		if targetColumn == "full" then
			targetColumn = nextAutoColumn
			nextAutoColumn = (nextAutoColumn == "left") and "right" or "left"
		end

		local target = targetColumn == "right" and right or left
		if section.container and section.container.Parent ~= target then
			section.container.Parent = target
		end
	end
end

function Library:_applyResponsiveLayout()
	if not self.main then return self end
	local camera = workspace.CurrentCamera
	if not camera then return self end
	local viewport = camera.ViewportSize
	local mobile = self.autoResponsive and (viewport.X <= self.mobileBreakpoint or (UserInputService.TouchEnabled and viewport.X < 900))
	self._mobileMode = mobile
	if mobile then
		local width = math.max(320, viewport.X - 20)
		local height = math.max(390, viewport.Y - 24)
		self.main.Size = UDim2.fromOffset(width, height)
		self.main.Position = UDim2.fromScale(0.5, 0.5)
		self.openSize = self.main.Size
		self.openPosition = self.main.Position
		self:SetSidebarCollapsed(true)
	else
		self.main.Size = UDim2.fromOffset(760, 500)
		self.main.Position = UDim2.fromScale(0.5, 0.5)
		self.openSize = self.main.Size
		self.openPosition = self.main.Position

		-- Restore desktop NeverLose rail even if the UI was previously mobile.
		if self.content then
			self.content.Position = UDim2.fromOffset(176, 0)
			self.content.Size = UDim2.new(1, -176, 1, 0)
		end
	end
	for _, page in ipairs(self.pages) do self:_applyPageLayout(page, mobile) end
	return self
end

