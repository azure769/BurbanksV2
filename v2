function Section:addKeybind(data)
	data = data or {}
	local options = {
		title = tostring(data.title or data.Title or "KEYBIND"),
		key = data.key or Enum.KeyCode.Unknown,
		gameProcessedEvent = data.gameProcessedEvent == true,
		callback = data.callback or data.Callback or function() end,
		changedCallback = data.changedCallback or function() end,
	}
	local module = createBoxedModule(self, 30)
	local button = create("TextButton", {
		Parent = module, Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	})
	local infoText = getInfoText(data)
	local title = createBoxedTitle(self, button, options.title, infoText and 110 or 82)
	createInfoHint(self, button, infoText, 72)

	local keyBox = create("TextLabel", {
		Parent = button, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, infoText and -34 or -10, 0.5, 0),
		Size = UDim2.fromOffset(60, 18), BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium, Text = formatKey(options.key), TextSize = 10,
	})
	bindTheme(self.library, keyBox, "BackgroundColor3", "Card2")
	bindTheme(self.library, keyBox, "TextColor3", "Text")
	keyBox.TextTransparency = 0.5
	corner(keyBox, 4)
	local keyStroke = stroke(keyBox, self.library.theme.Stroke, 0.65, 1)
	bindTheme(self.library, keyStroke, "Color", "Stroke")

	local function resizeKeyBox()
		local size = TextService:GetTextSize(keyBox.Text, 10, Enum.Font.GothamMedium, Vector2.new(math.huge, math.huge))
		keyBox.Size = UDim2.fromOffset(math.clamp(size.X + 10, 34, 76), 18)
	end
	resizeKeyBox()

	local listening = false
	button.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		keyBox.Text = "..."
		resizeKeyBox()
		task.spawn(function()
			local inputObject
			repeat inputObject = UserInputService.InputBegan:Wait()
			until inputObject.UserInputType == Enum.UserInputType.Keyboard
			if inputObject.KeyCode == Enum.KeyCode.Escape or inputObject.KeyCode == Enum.KeyCode.Backspace then
				options.key = Enum.KeyCode.Unknown
			else
				options.key = inputObject.KeyCode
			end
			keyBox.Text = formatKey(options.key)
			resizeKeyBox()
			listening = false
			safeCall(options.changedCallback, options.key)
		end)
	end)

	local connection = UserInputService.InputBegan:Connect(function(inputObject, processed)
		if listening or inputObject.KeyCode ~= options.key or options.key == Enum.KeyCode.Unknown or processed ~= options.gameProcessedEvent then return end
		safeCall(options.callback)
	end)
	self.library._connections[#self.library._connections + 1] = connection

	local controller = { Instance = module, Options = options }
	function controller:SetKey(key)
		if typeof(key) == "InputObject" then key = key.KeyCode end
		options.key = typeof(key) == "EnumItem" and key or Enum.KeyCode.Unknown
		keyBox.Text = formatKey(options.key)
		resizeKeyBox()
		safeCall(options.changedCallback, options.key)
		return self
	end
	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then options.title = tostring(newOptions.title); title.Text = options.title end
		if newOptions.key ~= nil then self:SetKey(newOptions.key) end
		if newOptions.gameProcessedEvent ~= nil then options.gameProcessedEvent = newOptions.gameProcessedEvent == true end
		if typeof(newOptions.callback) == "function" then options.callback = newOptions.callback end
		if typeof(newOptions.changedCallback) == "function" then options.changedCallback = newOptions.changedCallback end
		return self
	end
	self.modules[#self.modules + 1] = controller
	return controller
end
