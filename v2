	local fill = create("Frame", {
		Parent = slider, Size = UDim2.new(options.transparency, 0, 1, 0), BorderSizePixel = 0,
	})
	bindTheme(self.library, fill, "BackgroundColor3", "Accent")
	corner(fill, 6)

	local knob = create("Frame", {
		Parent = slider, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(options.transparency, 0, 0.5, 0),
		Size = UDim2.fromOffset(13, 13), BorderSizePixel = 0,
	})
	bindTheme(self.library, knob, "BackgroundColor3", "Text")
	corner(knob, 7)
	local knobStroke = stroke(knob, self.library.theme.Stroke, 0.15, 1)
	bindTheme(self.library, knobStroke, "Color", "Stroke")

	local dragging = false
	local function setTransparencyFromX(x, callCallback)
		local width = slider.AbsoluteSize.X
		if width <= 0 then return end
		local alpha = math.clamp((x - slider.AbsolutePosition.X) / width, 0, 1)
		options.transparency = alpha
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		transparencyValue.Text = ("%d%%"):format(math.floor(alpha * 100 + 0.5))
		preview.BackgroundTransparency = alpha
		if callCallback ~= false then fireChanged() end
	end

	slider.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setTransparencyFromX(input.Position.X, true)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			setTransparencyFromX(input.Position.X, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local opened = false
	local function setOpen(state)
		opened = state == true
		panel.Visible = opened
		tween(module, 0.18, { Size = UDim2.new(1, 0, 0, opened and 130 or 30) })
	end

	header.MouseButton1Click:Connect(function() setOpen(not opened) end)

	local function refreshAll()
		transparencyValue.Text = ("%d%%"):format(math.floor(options.transparency * 100 + 0.5))
		fill.Size = UDim2.new(options.transparency, 0, 1, 0)
		knob.Position = UDim2.new(options.transparency, 0, 0.5, 0)
		refreshPreview()
	end
	refreshAll()

	local controller = { Instance = module, Options = options, Preview = preview }
	function controller:Set(color, transparency, callCallback)
		if typeof(color) == "Color3" then options.color3 = color end
		if tonumber(transparency) ~= nil then options.transparency = math.clamp(tonumber(transparency), 0, 1)
		elseif typeof(transparency) == "boolean" and callCallback == nil then callCallback = transparency end
		refreshAll()
		if callCallback ~= false then fireChanged() end
		return self
	end
	function controller:SetTransparency(value, callCallback)
		options.transparency = math.clamp(tonumber(value) or options.transparency, 0, 1)
		refreshAll()
		if callCallback ~= false then fireChanged() end
		return self
	end
	function controller:Get() return options.color3, options.transparency end
	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil or newOptions.Title ~= nil then options.title = tostring(newOptions.title or newOptions.Title); title.Text = options.title end
		local newColor = newOptions.default or newOptions.color3 or newOptions.Color
		if typeof(newColor) == "Color3" then options.color3 = newColor end
		local newTransparency = newOptions.transparency or newOptions.Transparency
		if newTransparency ~= nil then options.transparency = math.clamp(tonumber(newTransparency) or options.transparency, 0, 1) end
		if typeof(newOptions.callback) == "function" then options.callback = newOptions.callback
		elseif typeof(newOptions.Callback) == "function" then options.callback = newOptions.Callback end
		refreshAll()
		return self
	end
	self.modules[#self.modules + 1] = controller
	return controller
end
