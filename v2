	})
	bindTheme(self, notifyFrame, "BackgroundColor3", "Card")
	notifyFrame.BackgroundTransparency = 0.075
	corner(notifyFrame, 10)

	local notifyStroke = stroke(notifyFrame, self.theme.Stroke, 0.650, 1)
	bindTheme(self, notifyStroke, "Color", "Stroke")

	local iconHolder = create("Frame", {
		Parent = notifyFrame,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(35, 35),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 172,
	})

	local notifyIcon = createLucideIcon(self, iconHolder, iconName, 21, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(21, 21),
		ZIndex = 173,
	}, "Accent")
	notifyIcon.ImageTransparency = 0

	local title = createLabel(self, notifyFrame, titleText, 17, Enum.Font.GothamBold)
	title.Position = UDim2.fromOffset(50, 7)
	title.Size = UDim2.new(1, -60, 0, 20)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTransparency = 0
	title.ZIndex = 173

	local content = createLabel(self, notifyFrame, contentText, 12, Enum.Font.GothamBold)
	content.Position = UDim2.fromOffset(50, 28)
	content.Size = UDim2.new(1, -60, 0, 15)
	content.TextXAlignment = Enum.TextXAlignment.Left
	content.TextTransparency = 0.650
	content.TextTruncate = Enum.TextTruncate.AtEnd
	content.ZIndex = 173
	bindTheme(self, content, "TextColor3", "Text")

	local titleSize = TextService:GetTextSize(
		title.Text, scaledTextSize(17), Enum.Font.GothamBold, Vector2.new(math.huge, math.huge)
	)
	local contentSize = TextService:GetTextSize(
		content.Text, scaledTextSize(12), Enum.Font.GothamBold, Vector2.new(math.huge, math.huge)
	)
	local mainWidth = math.max(titleSize.X, contentSize.X)
	local finalWidth = math.clamp(mainWidth + 65, 220, 430)
	notifyFrame.Size = UDim2.fromOffset(finalWidth, 55)

	tween(
		notifyFrame, 0.5,
		{ Position = UDim2.new(1, 0, 0, 0) },
		Enum.EasingStyle.Quint, Enum.EasingDirection.Out
	)

	local closed = false
	local function close(result)
		if closed then return end
		closed = true
		safeCall(data.callback or data.Callback, result)

		tween(notifyFrame, 0.175, { BackgroundTransparency = 1 })
		tween(notifyStroke, 0.175, { Transparency = 1 })
		tween(notifyIcon, 0.175, { ImageTransparency = 1 })
		tween(title, 0.175, { TextTransparency = 1 })
		tween(content, 0.175, { TextTransparency = 1 })

		task.delay(0.19, function()
			if containerFrame and containerFrame.Parent then
				containerFrame:Destroy()
			end
		end)
	end

	task.delay(duration, function()
		if containerFrame and containerFrame.Parent then
			close(nil)
		end
	end)

	return {
		Instance = notifyFrame,
		Close = close,
	}
end

