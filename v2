function Library.new(data)
    data = data or {}
    local self = setmetatable({}, Library)

    self.title           = tostring(data.title    or data.Title    or "BURBANKS")
    self.subtitle        = tostring(data.subtitle or data.Subtitle or "PRIVATE BUILD")
    self.logoTextValue   = tostring(data.logoText or data.LogoText or "N")
    self.logoImageValue  = normalizeAssetId(data.logo or data.Logo or data.logoImage or data.LogoImage or 77496338127881)
    self.backgroundImageValue = normalizeAssetId(data.background or data.Background or data.backgroundImage or data.BackgroundImage)
    self.backgroundTransparency = math.clamp(tonumber(data.backgroundTransparency or data.BackgroundTransparency) or 0.35, 0, 1)

    local dashboardData    = data.dashboard or data.Dashboard or {}
    self.dashboardTitle    = tostring(dashboardData.title    or dashboardData.Title    or data.dashboardTitle    or data.DashboardTitle    or "DASHBOARD")
    self.dashboardSubtitle = tostring(dashboardData.subtitle or dashboardData.Subtitle or data.dashboardSubtitle or data.DashboardSubtitle or "Configure modules and preferences")

    self.theme = copyTable(NL_THEME)
    self.startThemePreset = tostring(data.themePreset or data.ThemePreset or data.theme or data.Theme or "Walled Waves")

    if THEME_PRESETS[self.startThemePreset] then
        for k,v in pairs(THEME_PRESETS[self.startThemePreset]) do self.theme[k]=v end
    else
        self.startThemePreset = "Walled Waves"
    end

    self.currentThemePreset = self.startThemePreset
    self.pages              = {}
    self.focusedPage        = nil
    self._themeObjects      = {}
    self._themeRefreshers   = {}
    self._connections       = {}
    self._visible           = true
    self._busy              = false
    self.uiScale            = math.clamp(tonumber(data.uiScale or data.UIScale or data.scale or data.Scale) or 1, 0.55, 1.35)
    self.autoResponsive     = data.autoResponsive ~= false and data.AutoResponsive ~= false
    self.sidebarCollapsed   = data.sidebarCollapsed == true or data.SidebarCollapsed == true
    self.mobileBreakpoint   = math.clamp(tonumber(data.mobileBreakpoint or data.MobileBreakpoint) or 700, 480, 1000)
    self._mobileMode        = false

    -- startup / key system fields (Burbanks verbatim)
    self.startupAnimation   = data.startupAnimation ~= false
    self.startupDuration    = tonumber(data.startupDuration) or 0.45
    self.startupMenu        = data.startupMenu ~= false and data.StartupMenu ~= false
    self.startupMenuDuration= math.max(0.6, tonumber(data.startupMenuDuration or data.StartupMenuDuration) or 1.8)
    self.startupTitle       = tostring(data.startupTitle or data.StartupTitle or self.title)
    self.startupSubtitle    = tostring(data.startupSubtitle or data.StartupSubtitle or self.subtitle)
    self.startupVersion     = tostring(data.startupVersion or data.StartupVersion or "Loading interface")

    local keyData           = data.keySystem or data.KeySystem or {}
    self.keySystem          = keyData
    self.keyEnabled         = keyData.enabled == true or keyData.Enabled == true
    self.keyValue           = tostring(keyData.key or keyData.Key or "")
    self.keyTitle           = tostring(keyData.title or keyData.Title or self.title)
    self.keySubtitle        = tostring(keyData.subtitle or keyData.Subtitle or "KEY SYSTEM")
    self.keyDescription     = tostring(keyData.description or keyData.Description or "Enter your access key to continue.")
    self.keyPlaceholder     = tostring(keyData.placeholder or keyData.Placeholder or "Enter key...")
    self.keyButtonText      = tostring(keyData.buttonText or keyData.ButtonText or "VERIFY KEY")
    self.keyGetButtonText   = tostring(keyData.getKeyButtonText or keyData.GetKeyButtonText or "GET KEY")
    self.keyGetUrl          = tostring(keyData.getKeyUrl or keyData.GetKeyUrl or "")
    self.keyRemember        = keyData.remember == true or keyData.Remember == true
    self.keyFileName        = tostring(keyData.fileName or keyData.FileName or (self.title:gsub("%W+","_").."_key.txt"))
    self.keyValidate        = keyData.validate or keyData.Validate

    if typeof(data.theme) == "table" then
        for key,value in pairs(data.theme) do
            if self.theme[key] ~= nil and typeof(value) == "Color3" then self.theme[key]=value end
        end
    end

    -- ── NeverLose ScreenGui (replaces Burbanks guiParent ScreenGui) ──
    -- We reuse NeverLose.ScreenGui (GlobalWindow) as the container so NL
    -- rendering primitives (blur, shadows, colorpicker, etc.) all land
    -- on the same protected gui.
    local screenGui = NeverLose.ScreenGui

    -- ── Key System overlay (NeverLose card style) ─────────────────
    local keyOverlay, keyCard, keyCardScale, keyInput, keyStatus

    if self.keyEnabled then
        keyOverlay = create("Frame",{
            Name="KeySystemOverlay", Parent=screenGui,
            Size=UDim2.fromScale(1,1), BackgroundTransparency=1, BorderSizePixel=0,
            Visible=not self.startupMenu, ZIndex=300,
        })

        keyCard = create("Frame",{
            Name="KeySystemCard", Parent=keyOverlay,
            AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
            Size=UDim2.fromOffset(390,250), BorderSizePixel=0, ZIndex=301,
        })
        bindTheme(self, keyCard, "BackgroundColor3", "Background2")
        corner(keyCard,14)
        local keyStroke = stroke_ui(keyCard, self.theme.Stroke, 0.25, 1)
        bindTheme(self, keyStroke, "Color", "Stroke")
        keyCardScale = create("UIScale",{Parent=keyCard, Scale=0.96})

        local keyLogoHolder = create("Frame",{
            Parent=keyCard, Position=UDim2.fromOffset(18,18),
            Size=UDim2.fromOffset(48,48), BorderSizePixel=0, ZIndex=302,
        })
        bindTheme(self, keyLogoHolder, "BackgroundColor3", "Card")
        corner(keyLogoHolder,11)
        local keyLogoStroke = stroke_ui(keyLogoHolder, self.theme.Stroke, 0.25, 1)
        bindTheme(self, keyLogoStroke, "Color", "Accent")

        local keyLogo = create("ImageLabel",{
            Parent=keyLogoHolder, Size=UDim2.fromScale(1,1),
            BackgroundTransparency=1, Image=self.logoImageValue,
            ScaleType=Enum.ScaleType.Crop, Visible=self.logoImageValue~="", ZIndex=303,
        })
        keyLogo.ImageColor3 = Color3.fromRGB(255,255,255)
        corner(keyLogo,11)

        local keyLogoText = createLabel(self, keyLogoHolder, self.logoTextValue, 18, Enum.Font.GothamBold)
        keyLogoText.Size=UDim2.fromScale(1,1); keyLogoText.TextXAlignment=Enum.TextXAlignment.Center
        keyLogoText.Visible=self.logoImageValue==""; keyLogoText.ZIndex=303
        bindTheme(self, keyLogoText, "TextColor3", "Accent")

        local keyTitleLabel = createLabel(self, keyCard, self.keyTitle, 16, Enum.Font.GothamBold)
        keyTitleLabel.Position=UDim2.fromOffset(78,17); keyTitleLabel.Size=UDim2.new(1,-96,0,24); keyTitleLabel.ZIndex=302

        local keySubtitleLabel = createLabel(self, keyCard, self.keySubtitle, 9, Enum.Font.GothamBold)
        keySubtitleLabel.Position=UDim2.fromOffset(78,40); keySubtitleLabel.Size=UDim2.new(1,-96,0,18); keySubtitleLabel.ZIndex=302
        bindTheme(self, keySubtitleLabel, "TextColor3", "Muted"); keySubtitleLabel.TextTransparency=0.35

        local keyDescriptionLabel = createLabel(self, keyCard, self.keyDescription, 10, Enum.Font.GothamMedium)
        keyDescriptionLabel.Position=UDim2.fromOffset(18,80); keyDescriptionLabel.Size=UDim2.new(1,-36,0,18); keyDescriptionLabel.ZIndex=302
        bindTheme(self, keyDescriptionLabel, "TextColor3", "Muted"); keyDescriptionLabel.TextTransparency=0.2

        local inputHolder = create("Frame",{
            Parent=keyCard, Position=UDim2.fromOffset(18,108),
            Size=UDim2.new(1,-36,0,42), BorderSizePixel=0, ZIndex=302,
        })
        bindTheme(self, inputHolder, "BackgroundColor3", "Card")
        corner(inputHolder,9)
        local inputStroke = stroke_ui(inputHolder, self.theme.Stroke, 0.45, 1)
        bindTheme(self, inputStroke, "Color", "Stroke")

        keyInput = create("TextBox",{
            Parent=inputHolder, Position=UDim2.fromOffset(12,0),
            Size=UDim2.new(1,-24,1,0), BackgroundTransparency=1, BorderSizePixel=0,
            ClearTextOnFocus=false, Font=Enum.Font.GothamMedium,
            PlaceholderText=self.keyPlaceholder, Text="", TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=303,
        })
        bindTheme(self, keyInput, "TextColor3", "Text")
        bindTheme(self, keyInput, "PlaceholderColor3", "Muted")

        local verifyButton = create("TextButton",{
            Parent=keyCard, Position=UDim2.fromOffset(18,162),
            Size=self.keyGetUrl~="" and UDim2.new(0.5,-23,0,38) or UDim2.new(1,-36,0,38),
            BorderSizePixel=0, AutoButtonColor=false, Font=Enum.Font.GothamBold,
            Text=self.keyButtonText, TextSize=11, ZIndex=302,
        })
        bindTheme(self, verifyButton, "BackgroundColor3", "AccentDark")
        bindTheme(self, verifyButton, "TextColor3", "Text")
        corner(verifyButton,9)

        if self.keyGetUrl ~= "" then
            local getKeyButton = create("TextButton",{
                Parent=keyCard, AnchorPoint=Vector2.new(1,0),
                Position=UDim2.new(1,-18,0,162), Size=UDim2.new(0.5,-23,0,38),
                BorderSizePixel=0, AutoButtonColor=false, Font=Enum.Font.GothamBold,
                Text=self.keyGetButtonText, TextSize=11, ZIndex=302,
            })
            bindTheme(self, getKeyButton, "BackgroundColor3", "Card2")
            bindTheme(self, getKeyButton, "TextColor3", "Text")
            corner(getKeyButton,9)
            local gks = stroke_ui(getKeyButton, self.theme.Stroke, 0.45, 1)
            bindTheme(self, gks, "Color", "Stroke")
            getKeyButton.MouseButton1Click:Connect(function()
                if typeof(setclipboard)=="function" then pcall(setclipboard, self.keyGetUrl) end
                if keyStatus then
                    keyStatus.Text="Key link copied to clipboard."
                    bindTheme(self, keyStatus, "TextColor3", "Accent")
                end
            end)
        end

        keyStatus = createLabel(self, keyCard, "", 9, Enum.Font.GothamMedium)
        keyStatus.Position=UDim2.fromOffset(18,210); keyStatus.Size=UDim2.new(1,-36,0,20)
        keyStatus.TextXAlignment=Enum.TextXAlignment.Center; keyStatus.ZIndex=302
        bindTheme(self, keyStatus, "TextColor3", "Muted")

        self.keyOverlay = keyOverlay; self.keyCard=keyCard
        self.keyInput=keyInput; self.keyStatus=keyStatus; self.keyVerified=false

        local function validateKey(candidate)
            if typeof(self.keyValidate)=="function" then
                local ok,result = pcall(self.keyValidate, candidate, self)
                return ok and result==true
            end
            return candidate == self.keyValue
        end

        local function rememberKey(candidate)
            if not self.keyRemember then return end
            if typeof(writefile)=="function" then pcall(writefile, self.keyFileName, candidate) end
        end

        local function animateMainFromKey()
            if not self.main or not self.main.Parent then return end
            self.main.Visible=true
            local finalPosition=UDim2.fromScale(0.5,0.5)
            self.main.Position=UDim2.new(0.5,0,0.5,16)
            self.main.BackgroundTransparency=1
            self.startupScale.Scale=math.max(0.5, self.uiScale*0.9)
            tween_ui(self.main, self.startupDuration, {Position=finalPosition, BackgroundTransparency=0.055})
            tween_ui(self.startupScale, self.startupDuration, {Scale=self.uiScale}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            self.openPosition=finalPosition; self.openSize=self.main.Size
        end

        local function submitKey()
            local candidate = tostring(keyInput.Text or ""):match("^%s*(.-)%s*$")
            if candidate=="" then
                keyStatus.Text="Enter a key first."
                bindTheme(self, keyStatus, "TextColor3", "Danger")
