	local title = createBoxedTitle(self, button, options.title, infoText and 78 or 54)
	createInfoHint(self, button, infoText, 44)

	local track = create("Frame", {
		Parent = button, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, infoText and -34 or -10, 0.5, 0),
		Size = UDim2.fromOffset(32, 18), BorderSizePixel = 0,
	})
	bindTheme(self.library, track, "BackgroundColor3", "Background2")
