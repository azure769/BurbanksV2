    if forceState~=nil then self._visible=forceState==true else self._visible=not self._visible end
    self._busy=true
    if self._visible then
        self.main.Visible=true
        self.main.Size=UDim2.fromOffset(self.openSize.X.Offset,0)
        tween_ui(self.main, 0.22, {Size=self.openSize, Position=self.openPosition}).Completed:Wait()
        self._windowShadow:Render(true)
    else
