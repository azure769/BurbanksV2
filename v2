local function makeDraggable(handle, target)
	target = target or handle
	local dragging = false
	local dragInput
	local startMouse
	local startPosition
	local desiredPosition = target.Position
	local restingSize = target.Size
	local sizeTween
	local settleTween
	local DRAG_SMOOTHNESS = 22
	local PICKUP_PIXELS = 4
	handle.Active = true

	local function cancelTween(animation)
		if animation then animation:Cancel() end
	end

	handle.InputBegan:Connect(function(inputObject)
		local inputType = inputObject.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		dragInput = inputObject
		startMouse = inputObject.Position
		startPosition = target.Position
		desiredPosition = target.Position
		restingSize = target.Size
		cancelTween(sizeTween)
		cancelTween(settleTween)
		sizeTween = tween(target, 0.12, {
			Size = UDim2.new(restingSize.X.Scale, restingSize.X.Offset + PICKUP_PIXELS, restingSize.Y.Scale, restingSize.Y.Offset + PICKUP_PIXELS)
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	end)

	UserInputService.InputChanged:Connect(function(inputObject)
		if not dragging then return end
		local validMouse = inputObject.UserInputType == Enum.UserInputType.MouseMovement
		local validTouch = dragInput and dragInput.UserInputType == Enum.UserInputType.Touch and inputObject == dragInput
		if not validMouse and not validTouch then return end
		local delta = inputObject.Position - startMouse
		desiredPosition = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	end)

	RunService.RenderStepped:Connect(function(deltaTime)
		if not dragging then return end
		local alpha = 1 - math.exp(-DRAG_SMOOTHNESS * deltaTime)
		target.Position = target.Position:Lerp(desiredPosition, alpha)
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		local endedMouse = inputObject.UserInputType == Enum.UserInputType.MouseButton1
		local endedTouch = dragInput and inputObject == dragInput
		if not dragging or (not endedMouse and not endedTouch) then return end
		dragging = false
		dragInput = nil
		cancelTween(sizeTween)
		cancelTween(settleTween)
		settleTween = tween(target, 0.14, { Position = desiredPosition }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		sizeTween = tween(target, 0.16, { Size = restingSize }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
end

local function formatKey(keyCode)
	if keyCode == Enum.KeyCode.Unknown then return "NONE" end
	local text = UserInputService:GetStringForKeyCode(keyCode)
	return string.upper(text ~= "" and text or keyCode.Name)
end

local function round(value, precision)
	precision = precision or 0
	if precision == -1 then return value end
	local multiplier = 10 ^ precision
	return math.floor(value * multiplier + 0.5) / multiplier
end

