    local function applySearchFilter(query)
        query = string.lower(tostring(query or ""))
        local page = self.focusedPage
        if not page or not page.sections then return end
        for _, section in ipairs(page.sections) do
            local sectionMatch = query=="" or string.find(string.lower(section.title or ""),query,1,true)~=nil
            local anyVisible   = false
            for _, child in ipairs(section.moduleContainer:GetChildren()) do
                if child:IsA("GuiObject") then
                    local hay = ""
                    for _, d in ipairs(child:GetDescendants()) do
                        if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.Text then
                            hay ..= " "..string.lower(d.Text)
                        end
                    end
                    local show = query=="" or sectionMatch or string.find(hay,query,1,true)~=nil
                    child.Visible=show; anyVisible=anyVisible or show
                end
            end
            section.container.Visible = query=="" or sectionMatch or anyVisible
        end
    end
