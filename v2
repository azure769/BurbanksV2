function Library:_applyPageLayout(page, mobile)
    if not page or not page._columns then return end
    local left=page._columns.left; local right=page._columns.right; local full=page._columns.full
    if not left or not right or not full then return end
    local sections=page.sections or {}; local hasFull=false
    for _, section in ipairs(sections) do if section.column=="full" then hasFull=true; break end end
    if hasFull then
        full.Visible=true; left.Visible=false; right.Visible=false
        for _, section in ipairs(sections) do
            if section.container and section.container.Parent~=full then section.container.Parent=full end
        end
        full.Position=UDim2.fromOffset(0,0); full.Size=UDim2.new(1,0,1,0)
        return
    end
    full.Visible=false; left.Visible=true; right.Visible=true
    if #sections<=1 then
        local onlySection=sections[1]; local onlyColumn=onlySection and onlySection.column or "left"
        if onlyColumn=="right" then
            left.Visible=false; right.Visible=true; right.Position=UDim2.fromOffset(0,0); right.Size=UDim2.new(1,0,1,0)
        else
            left.Visible=true; right.Visible=false; left.Position=UDim2.fromOffset(0,0); left.Size=UDim2.new(1,0,1,0)
        end
        return
    end
    if mobile then
        left.Size=UDim2.new(1,0,0.5,-4); left.Position=UDim2.fromOffset(0,0)
        right.Position=UDim2.new(0,0,0.5,4); right.Size=UDim2.new(1,0,0.5,-4)
    else
        left.Position=UDim2.fromOffset(0,0); left.Size=UDim2.new(0.5,-6,1,0)
        right.Position=UDim2.new(0.5,6,0,0); right.Size=UDim2.new(0.5,-6,1,0)
    end
end

function Library:_applyResponsiveLayout()
    if not self.main then return self end
    local camera=workspace.CurrentCamera; if not camera then return self end
    local viewport=camera.ViewportSize
    local mobile=self.autoResponsive and (viewport.X<=self.mobileBreakpoint or (UserInputService.TouchEnabled and viewport.X<900))
    self._mobileMode=mobile
    if mobile then
        local width=math.max(320,viewport.X-20); local height=math.max(390,viewport.Y-24)
        self.main.Size=UDim2.fromOffset(width,height); self.main.Position=UDim2.fromScale(0.5,0.5)
        self.openSize=self.main.Size; self.openPosition=self.main.Position
        self:SetSidebarCollapsed(true)
    else
        self.main.Size=UDim2.fromOffset(800,600); self.main.Position=UDim2.fromScale(0.5,0.5)
        self.openSize=self.main.Size; self.openPosition=self.main.Position
    end
    for _, page in ipairs(self.pages) do self:_applyPageLayout(page, self._mobileMode) end
    return self
end

function Library:SetMobileMode(enabled)
    self.autoResponsive=false; self._mobileMode=enabled==true
    if self._mobileMode then self:SetSidebarCollapsed(true) end
    for _, page in ipairs(self.pages) do self:_applyPageLayout(page, self._mobileMode) end
    return self
end
