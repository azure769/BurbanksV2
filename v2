function NeverLose:CreateShadow(parent, RollingEffect)
    local Shadow = {}
    local s85 = Instance.new("UIStroke"); s85.Thickness = 6; s85.Transparency = 1; s85.Parent = parent
    local s65 = Instance.new("UIStroke"); s65.Thickness = 5; s65.Transparency = 1; s65.Parent = parent
    local s50 = Instance.new("UIStroke"); s50.Thickness = 4; s50.Transparency = 1; s50.Parent = parent
    local s45 = Instance.new("UIStroke"); s45.Thickness = 3; s45.Transparency = 1; s45.Parent = parent
    local RollingEffectThread
    local r1,r2,r3,r4
    if RollingEffect then
        r1 = NeverLose:RollingEffect(s85)
        r2 = NeverLose:RollingEffect(s65)
        r3 = NeverLose:RollingEffect(s50)
        r4 = NeverLose:RollingEffect(s45)
    end
    Shadow.Render = LPH_NO_VIRTUALIZE(function(self, value)
        if RollingEffectThread then task.cancel(RollingEffectThread); RollingEffectThread = nil end
        if value then
            NeverLose.PlayAnimate(s85,SlowyTween,{Transparency=0.900})
            NeverLose.PlayAnimate(s65,SlowyTween,{Transparency=0.900})
            NeverLose.PlayAnimate(s50,SlowyTween,{Transparency=0.900})
            NeverLose.PlayAnimate(s45,SlowyTween,{Transparency=0.900})
            if RollingEffect then
                RollingEffectThread = task.spawn(function()
                    local level = 20
                    while true do task.wait(0.025)
                        NeverLose.PlayAnimate(r1,SlowyTween,{Rotation=r1.Rotation+level})
                        NeverLose.PlayAnimate(r2,SlowyTween,{Rotation=r2.Rotation+level})
                        NeverLose.PlayAnimate(r3,SlowyTween,{Rotation=r3.Rotation+level})
                        NeverLose.PlayAnimate(r4,SlowyTween,{Rotation=r4.Rotation+level})
                    end
                end)
            end
        else
            NeverLose.PlayAnimate(s85,SlowyTween,{Transparency=1})
            NeverLose.PlayAnimate(s65,SlowyTween,{Transparency=1})
            NeverLose.PlayAnimate(s50,SlowyTween,{Transparency=1})
            NeverLose.PlayAnimate(s45,SlowyTween,{Transparency=1})
        end
    end)
    return Shadow
end

-- ── ParseInput / ProcessDropdown / ParseDropdown (NeverLose) ────
function NeverLose:ParseInput(Value, Numeric)
    if not Value then return (Numeric and nil) or "" end
    if Numeric then
        local out = string.gsub(tostring(Value), '[^0-9.%-]', '')
        if tonumber(out) then return tonumber(out) end
        return nil
    end
    return Value
end

NeverLose.ProcessDropdown = LPH_NO_VIRTUALIZE(function(value)
    if typeof(value) == 'table' then
        local data = {}
        for i,v in next, value do
            if typeof(v) == 'boolean' and typeof(i) ~= 'number' then data[i] = v
            else data[v] = true end
        end
        return data
    else return value end
end)

NeverLose.ParseDropdown = LPH_NO_VIRTUALIZE(function(value)
    if not value then return 'Select' end
    local Out
    if typeof(value) == 'table' then
        if #value > 0 then
            local x = {}
            for i,v in next, value do table.insert(x, tostring(v)) end
            Out = table.concat(x,' , ')
            table.clear(x)
        else
            local x = {}
            for i,v in next, value do if v == true then table.insert(x, tostring(i)) end end
            Out = table.concat(x,' , ')
            table.clear(x)
            if not Out:byte() then Out = 'Select' end
        end
    else
        Out = tostring(value or 'Select')
    end
    return Out
end)

