function Library:toggle(forceState)
	if self._busy then return end
	if forceState ~= nil then self._visible = forceState == true else self._visible = not self._visible end
	self._busy = true
	if self._visible then
		self.main.Visible = true
		self.main.Size = UDim2.fromOffset(self.openSize.X.Offset, 0)
		tween(self.main, 0.22, { Size = self.openSize, Position = self.openPosition }).Completed:Wait()
	else
		self.openPosition = self.main.Position
		self.openSize = self.main.Size
		tween(self.main, 0.2, { Size = UDim2.fromOffset(self.main.AbsoluteSize.X, 0) }).Completed:Wait()
