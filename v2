function Library:SelectPage(data)
	local selected = data and (data.page or data.Page)
	if not selected or self.focusedPage == selected then return end

	if self.focusedPage then
		local old = self.focusedPage
		old.container.Visible = false
		old.background.BackgroundTransparency = 1
		old.accent.BackgroundTransparency = 1
		old.buttonTitle.TextTransparency = 0.48

		if old.icon:IsA("ImageLabel") or old.icon:IsA("ImageButton") then
			old.icon.ImageColor3 = self.theme.Muted
			old.icon.ImageTransparency = 0.5
		else
			old.icon.TextColor3 = self.theme.Muted
			old.icon.TextTransparency = 0.5
		end
	end

	self.focusedPage = selected
	selected.container.Visible = true
	selected.background.BackgroundTransparency = 0.72
	selected.accent.BackgroundTransparency = 0
	selected.buttonTitle.TextColor3 = self.theme.Text
	selected.buttonTitle.TextTransparency = 0

	if selected.icon:IsA("ImageLabel") or selected.icon:IsA("ImageButton") then
		selected.icon.ImageColor3 = self.theme.Accent
		selected.icon.ImageTransparency = 0
	else
		selected.icon.TextColor3 = self.theme.Accent
		selected.icon.TextTransparency = 0
	end

	if self._applySearch and self.searchBox then
		self._applySearch(self.searchBox.Text)
	end
end
