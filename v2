		end)
		self._connections[#self._connections + 1] = viewportConnection
	end

	task.defer(function() self:_applyResponsiveLayout() end)

	if self.startupMenu then
		task.defer(function()
			local total = self.startupMenuDuration
			if startupCard and startupCard.Parent then
				tween(startupCardScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				tween(startupLogo, 0.35, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				tween(startupTitleLabel, 0.35, { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				tween(startupSubtitleLabel, 0.4, { TextTransparency = 0.25 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				tween(startupStatusLabel, 0.45, { TextTransparency = 0.45 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				tween(startupProgressFill, math.max(0.45, total - 0.35), { Size = UDim2.new(1, 0, 1, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				task.wait(math.max(0.2, total - 0.45))
				tween(startupCardScale, 0.28, { Scale = 0.96 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				tween(startupLogo, 0.22, { ImageTransparency = 1 })
				tween(startupTitleLabel, 0.22, { TextTransparency = 1 })
				tween(startupSubtitleLabel, 0.22, { TextTransparency = 1 })
				tween(startupStatusLabel, 0.22, { TextTransparency = 1 })
				if startupBlur and startupBlur.Parent then
					tween(startupBlur, 0.28, { Size = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
				end
				task.wait(0.3)
				if startupOverlay and startupOverlay.Parent then startupOverlay:Destroy() end
				if startupBlur and startupBlur.Parent then startupBlur:Destroy() end
			end

			if not main.Parent then return end

			if self.keyEnabled and not self.keyVerified then
				if keyOverlay and keyOverlay.Parent then
					keyOverlay.Visible = true
					if keyCardScale then
						keyCardScale.Scale = 0.94
						tween(keyCardScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					end
				end
				return
			end

			main.Visible = true
			if self.startupAnimation then
				local finalPosition = UDim2.fromScale(0.5, 0.5)
				local finalTransparency = 0.055
				main.Position = UDim2.new(finalPosition.X.Scale, finalPosition.X.Offset, finalPosition.Y.Scale, finalPosition.Y.Offset + 18)
				main.BackgroundTransparency = 1
				startupScale.Scale = math.max(0.5, self.uiScale * 0.88)
				local moveTween = tween(main, self.startupDuration, { Position = finalPosition, BackgroundTransparency = finalTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
				tween(startupScale, self.startupDuration, { Scale = self.uiScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				moveTween.Completed:Connect(function()
					if main.Parent then self.openPosition = main.Position; self.openSize = main.Size end
				end)
			else
				self.openPosition = main.Position
				self.openSize = main.Size
			end
		end)
	elseif self.startupAnimation then
		local finalPosition = main.Position
		local finalTransparency = main.BackgroundTransparency
		main.Position = UDim2.new(finalPosition.X.Scale, finalPosition.X.Offset, finalPosition.Y.Scale, finalPosition.Y.Offset + 18)
		main.BackgroundTransparency = 1
		startupScale.Scale = math.max(0.5, self.uiScale * 0.88)
		task.defer(function()
			local moveTween = tween(main, self.startupDuration, { Position = finalPosition, BackgroundTransparency = finalTransparency }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			tween(startupScale, self.startupDuration, { Scale = self.uiScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			moveTween.Completed:Connect(function()
				if main.Parent then self.openPosition = main.Position end
			end)
		end)
	end

	minimize.MouseButton1Click:Connect(function() self:toggle() end)
	return self
end

