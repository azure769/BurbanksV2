function Library:SetKey(value) self.keyValue=tostring(value or ""); return self end
Library.setKey = Library.SetKey

function Library:ShowKeySystem()
    if self.keyOverlay and self.keyOverlay.Parent then
        self.main.Visible=false; self.keyOverlay.Visible=true
        if self.keyCard then self.keyCard.Position=UDim2.fromScale(0.5,0.5) end
    end
    return self
end
Library.showKeySystem = Library.ShowKeySystem

function Library:SetScale(value)
    self.uiScale=math.clamp(tonumber(value) or self.uiScale or 1, 0.55, 1.35)
    if self.startupScale then tween_ui(self.startupScale, 0.16, {Scale=self.uiScale}) end
    return self
end
Library.setScale=Library.SetScale; Library.SetUIScale=Library.SetScale; Library.setUIScale=Library.SetScale
function Library:GetScale() return self.uiScale end
Library.GetUIScale=Library.GetScale

function Library:SetSidebarCollapsed(state)
    self.sidebarCollapsed=state==true
    if not self.sidebar or not self.content then return self end
    local collapsedWidth=58; local expandedWidth=190
    local width=self.sidebarCollapsed and collapsedWidth or expandedWidth
    tween_ui(self.sidebar, 0.18, {Size=UDim2.new(0,width,1,-50)})
    tween_ui(self.content, 0.18, {Position=UDim2.fromOffset(width+1,0), Size=UDim2.new(1,-(width+1),1,0)})
    if self.navigationLabel then self.navigationLabel.Visible=not self.sidebarCollapsed end
    if self.playerProfile   then self.playerProfile.Visible=not self.sidebarCollapsed end
    if self.playerProfileDivider then self.playerProfileDivider.Visible=not self.sidebarCollapsed end
    for _, page in ipairs(self.pages) do
        if page.buttonTitle then page.buttonTitle.Visible=not self.sidebarCollapsed end
        if page.icon then
            if page.icon:IsA("ImageLabel") or page.icon:IsA("ImageButton") then
                page.icon.Position=self.sidebarCollapsed and UDim2.fromOffset(18,7) or UDim2.fromOffset(7,7)
            else
                page.icon.Position=self.sidebarCollapsed and UDim2.fromOffset(14,0) or UDim2.fromOffset(7,0)
