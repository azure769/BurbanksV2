function Library:setTheme(data, color)
	local themeName, themeColor
	if typeof(data) == "table" then
		themeName = data.theme or data.Theme
		themeColor = data.color3 or data.Color or data.color
	else
		themeName = data
		themeColor = color
	end
	if self.theme[themeName] == nil or typeof(themeColor) ~= "Color3" then return false end
	self.theme[themeName] = themeColor
	for _, binding in ipairs(self._themeObjects) do
		local object = binding.Object
		if object and object.Parent and binding.Theme == themeName then object[binding.Property] = themeColor end
	end
	for _, refresher in ipairs(self._themeRefreshers) do
		local success, message = pcall(refresher)
		if not success then warn("[Burbanks theme refresh error]:", message) end
	end
	return true
end
Library.SetTheme = Library.setTheme

function Library:setThemePreset(name)
	local preset = THEME_PRESETS[tostring(name)]
	if not preset then return false end
	for themeName, themeColor in pairs(preset) do self:setTheme(themeName, themeColor) end
	self.currentThemePreset = tostring(name)
	if self.configNameLabel then self.configNameLabel.Text = self.currentThemePreset end
	return true
end
Library.SetThemePreset = Library.setThemePreset

function Library:getThemePresets()
	local names = {}
	for name in pairs(THEME_PRESETS) do names[#names + 1] = name end
	table.sort(names)
	return names
end
