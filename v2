-- ────────────────────────────────────────────────────────────────
-- Burbanks helpers (preserved verbatim from Burbanks source)
-- ────────────────────────────────────────────────────────────────
local TEXT_SCALE = 1.00

local function copyTable(source)
    local result = {}
    for k,v in pairs(source) do result[k]=v end
    return result
end

local function scaledTextSize(value)
    return math.max(1, math.floor((tonumber(value) or 12)*TEXT_SCALE+0.5))
end

local function create(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        if property == "TextSize" and typeof(value) == "number" then
            object[property] = scaledTextSize(value)
        else
            object[property] = value
        end
    end
    return object
end

local function normalizeAssetId(value)
    if value == nil then return "" end
    local text = tostring(value):match("^%s*(.-)%s*$")
    if text == "" then return "" end
    if text:match("^rbxassetid://") or text:match("^https?://") then return text end
    local id = text:match("(%d+)")
    return id and ("rbxassetid://"..id) or ""
end

local function corner(object, radius)
    return create("UICorner",{Parent=object,CornerRadius=UDim.new(0,radius or 6)})
end

local function stroke_ui(object, color, transparency, thickness)
    return create("UIStroke",{Parent=object,Color=color,Transparency=transparency or 0,Thickness=thickness or 1})
end

local function padding_ui(object, left, right, top, bottom)
    return create("UIPadding",{
        Parent=object,
        PaddingLeft=UDim.new(0,left or 0), PaddingRight=UDim.new(0,right or 0),
        PaddingTop=UDim.new(0,top or 0),   PaddingBottom=UDim.new(0,bottom or 0),
    })
end

local function tween_ui(object, duration, properties, style, direction)
    local animation = TweenService:Create(object,
        TweenInfo.new(duration or 0.18, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        properties)
    animation:Play()
    return animation
end

local function safeCall(callback, ...)
    if typeof(callback) ~= "function" then return end
    local ok, msg = pcall(callback, ...)
    if not ok then warn("[Burbanks callback error]:", msg) end
end

local function guiParent()
    if typeof(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and result then return result end
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function bindTheme(window, object, property, themeName)
    window._themeObjects[#window._themeObjects+1] = {Object=object,Property=property,Theme=themeName}
    object[property] = window.theme[themeName]
end

local function bindThemeRefresh(window, callback)
    window._themeRefreshers[#window._themeRefreshers+1] = callback
    callback()
end

local function refreshCanvas(scrollingFrame, layout, extra)
    local function update()
        scrollingFrame.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y+(extra or 0))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    update()
end

-- NeverLose-style drag replaces Burbanks makeDraggable
local function makeDraggable(handle, target)
    NeverLose.Drag(handle, target or handle, 0.05)
end

local function formatKey(keyCode)
    if keyCode == Enum.KeyCode.Unknown then return "NONE" end
    local text = UserInputService:GetStringForKeyCode(keyCode)
    return string.upper(text ~= "" and text or keyCode.Name)
end

local function round(value, precision)
    precision = precision or 0
    if precision == -1 then return value end
    local multiplier = 10^precision
    return math.floor(value*multiplier+0.5)/multiplier
end

local function createLabel(window, parent, text, size, font)
    local label = create("TextLabel",{
        Parent=parent, BackgroundTransparency=1,
        Font=font or Enum.Font.GothamMedium, Text=text or "",
        TextSize=size or 12,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center,
    })
    bindTheme(window, label, "TextColor3", "Text")
    return label
end

-- ── NeverLose-style row separator used by Burbanks section modules ──
local function createBoxedModule(section, height)
    local holder = create("Frame",{
        Parent=section.moduleContainer,
        Size=UDim2.new(1,0,0,height or 38),
        BorderSizePixel=0, BackgroundTransparency=1,
    })
    local rowLine = create("Frame",{
        Parent=holder, AnchorPoint=Vector2.new(0.5,1),
        Position=UDim2.new(0.5,0,1,0), Size=UDim2.new(1,-20,0,1), BorderSizePixel=0,
    })
    bindTheme(section.library, rowLine, "BackgroundColor3", "Stroke")
    rowLine.BackgroundTransparency = 1
    return holder
end

local function createBoxedTitle(section, parent, title, rightPadding)
    local label = createLabel(section.library, parent, tostring(title or "Module"), 13, Enum.Font.GothamMedium)
    label.Position = UDim2.fromOffset(11,0)
    label.Size     = UDim2.new(1,-(rightPadding or 24),1,0)
    bindTheme(section.library, label, "TextColor3", "Text")
    label.TextTransparency = 0.20
    return label
end

local function getInfoText(data)
    return data.info or data.Info or data.description or data.Description or data.comment or data.Comment
end

local function createInfoHint(section, parent, infoText, rightInset)
    if not infoText or tostring(infoText) == "" then return nil end
    local window = section.library
    local module = parent
    while module and module.Parent ~= section.moduleContainer do module = module.Parent end
    if not module then module = parent end

    local icon = create("TextButton",{
        Parent=module, AnchorPoint=Vector2.new(1,0.5),
        Position=UDim2.new(1,-4,0.5,0), Size=UDim2.fromOffset(22,22),
        BackgroundTransparency=1, BorderSizePixel=0, AutoButtonColor=false,
        Font=Enum.Font.GothamBold, Text="ⓘ", TextSize=17, ZIndex=100,
    })
    bindTheme(window, icon, "TextColor3", "Accent")

    local tooltip = create("Frame",{Parent=window.container, Visible=false, BorderSizePixel=0, ZIndex=500})
    bindTheme(window, tooltip, "BackgroundColor3", "Background2")
    corner(tooltip,8)
    local tooltipStroke = stroke_ui(tooltip, window.theme.Stroke, 0.15, 1)
    bindTheme(window, tooltipStroke, "Color", "Accent")

    local tooltipText = createLabel(window, tooltip, tostring(infoText), 11, Enum.Font.GothamMedium)
    tooltipText.Position=UDim2.fromOffset(8,6); tooltipText.TextWrapped=true
    tooltipText.TextXAlignment=Enum.TextXAlignment.Left; tooltipText.TextYAlignment=Enum.TextYAlignment.Top
    tooltipText.ZIndex=501
    bindTheme(window, tooltipText, "TextColor3", "Text"); tooltipText.TextTransparency=0.08

    local function updateTooltip()
        local maxWidth   = 220
        local measureSize = scaledTextSize(11)
        local firstPass  = TextService:GetTextSize(tostring(infoText), measureSize, Enum.Font.GothamMedium, Vector2.new(maxWidth,1000))
        local width      = math.clamp(firstPass.X+20, 120, maxWidth)
        local bounds     = TextService:GetTextSize(tostring(infoText), measureSize, Enum.Font.GothamMedium, Vector2.new(width-16,1000))
        tooltip.Size     = UDim2.fromOffset(width, bounds.Y+14)
        tooltipText.Size = UDim2.fromOffset(width-16, bounds.Y+2)
        local iconPos    = icon.AbsolutePosition
        local iconSize   = icon.AbsoluteSize
        local camera     = workspace.CurrentCamera
        local viewport   = camera and camera.ViewportSize or Vector2.new(1920,1080)
        local x = iconPos.X+iconSize.X+7
        local y = iconPos.Y+(iconSize.Y/2)-((bounds.Y+14)/2)
        if x+width > viewport.X-8 then x = iconPos.X-width-7 end
        if x < 8 then x = 8 end
        if y+bounds.Y+14 > viewport.Y-8 then y = viewport.Y-bounds.Y-22 end
        if y < 8 then y = 8 end
        tooltip.Position = UDim2.fromOffset(x,y)
    end
    icon.MouseEnter:Connect(function() updateTooltip(); tooltip.Visible=true end)
    icon.MouseLeave:Connect(function() tooltip.Visible=false end)
    return icon, tooltip
end

