function Section:addSlider(data)
	data = data or {}
	local options = {
		title = tostring(data.title or data.Title or "SLIDER"),
		min = tonumber(data.min) or 0,
		max = tonumber(data.max) or 100,
		precision = tonumber(data.precision) or 0,
		value = tonumber(data.default),
		callback = data.callback or data.Callback or function() end,
	}
	if options.max <= options.min then options.max = options.min + 1 end
	options.value = math.clamp(options.value or options.min, options.min, options.max)

	local module = createBoxedModule(self, 30)
	local infoText = getInfoText(data)
	local title = createBoxedTitle(self, module, options.title, infoText and 180 or 150)
	createInfoHint(self, module, infoText, 138)

	local control = create("Frame", {
		Parent = module, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, infoText and -34 or -10, 0.5, 0),
		Size = UDim2.fromOffset(128, 18), BackgroundTransparency = 1,
	})

	local valueFrame = create("Frame", {
		Parent = control, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(36, 18),
		BorderSizePixel = 0,
	})
	bindTheme(self.library, valueFrame, "BackgroundColor3", "Card2")
	corner(valueFrame, 4)
	local valueStroke = stroke(valueFrame, self.library.theme.Stroke, 0.65, 1)
	bindTheme(self.library, valueStroke, "Color", "Stroke")

	local valueLabel = createLabel(self.library, valueFrame, tostring(options.value), 10, Enum.Font.GothamMedium)
	valueLabel.Size = UDim2.fromScale(1, 1)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Center
	valueLabel.TextTransparency = 0.5

	local bar = create("Frame", {
		Parent = control, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -44, 0, 5), BorderSizePixel = 0,
	})
	bindTheme(self.library, bar, "BackgroundColor3", "Background2")
	corner(bar, 5)

	local fill = create("Frame", {
		Parent = bar, Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0,
	})
	bindTheme(self.library, fill, "BackgroundColor3", "Accent")
	corner(fill, 5)

	local knob = create("Frame", {
		Parent = fill, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(9, 9),
		BorderSizePixel = 0,
	})
	bindTheme(self.library, knob, "BackgroundColor3", "Text")
	corner(knob, 9)

	local dragging = false
	local function setValue(value, callCallback)
		value = math.clamp(tonumber(value) or options.min, options.min, options.max)
		value = round(value, options.precision)
		options.value = value
		local percentage = (value - options.min) / (options.max - options.min)
		valueLabel.Text = tostring(value)
		tween(fill, 0.08, { Size = UDim2.new(percentage, 0, 1, 0) })
		if callCallback ~= false then safeCall(options.callback, value) end
	end

	local function updateFromMouse()
		local percentage = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(options.min + (options.max - options.min) * percentage, true)
	end

	control.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			updateFromMouse()
		end
	end)
	UserInputService.InputChanged:Connect(function(inputObject)
		if dragging and inputObject.UserInputType == Enum.UserInputType.MouseMovement then updateFromMouse() end
	end)
	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)

	setValue(options.value, false)

	local controller = { Instance = module, Options = options }
	function controller:Set(value, callCallback) setValue(value, callCallback); return self end
	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then options.title = tostring(newOptions.title); title.Text = options.title end
		if newOptions.min ~= nil then options.min = tonumber(newOptions.min) or options.min end
		if newOptions.max ~= nil then options.max = tonumber(newOptions.max) or options.max end
		if newOptions.precision ~= nil then options.precision = tonumber(newOptions.precision) or options.precision end
		if newOptions.default ~= nil then setValue(newOptions.default, false)
		elseif newOptions.value ~= nil then setValue(newOptions.value, false) end
		if typeof(newOptions.callback) == "function" then options.callback = newOptions.callback end
		return self
	end
	self.modules[#self.modules + 1] = controller
	return controller
end
