	local knob = create("Frame", {
		Parent = track, AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
	})
	corner(knob, 16)

	local function refresh(animated)
		local position = options.toggled and UDim2.new(0.7, 0, 0.5, 0) or UDim2.new(0.3, 0, 0.5, 0)
		local trackColor = options.toggled and self.library.theme.Accent or Color3.fromRGB(10, 13, 21)
		local knobTransparency = options.toggled and 0 or 0.5
		if animated then
			tween(track, 0.175, { BackgroundColor3 = trackColor, BackgroundTransparency = 0 })
			tween(knob, 0.175, { Position = position, BackgroundTransparency = knobTransparency })
		else
			track.BackgroundColor3 = trackColor
			track.BackgroundTransparency = 0
			knob.Position = position
			knob.BackgroundTransparency = knobTransparency
		end
	end

	bindThemeRefresh(self.library, function() refresh(false) end)
	button.MouseButton1Click:Connect(function()
		options.toggled = not options.toggled
		refresh(true)
		safeCall(options.callback, options.toggled)
	end)

	local controller = { Instance = module, Options = options }
	function controller:Set(value, callCallback)
		options.toggled = value == true
		refresh(true)
		if callCallback ~= false then safeCall(options.callback, options.toggled) end
		return self
	end
	function controller:Update(newOptions)
		newOptions = newOptions or {}
		if newOptions.title ~= nil then options.title = tostring(newOptions.title); title.Text = options.title end
		if newOptions.default ~= nil then self:Set(newOptions.default, false)
		elseif newOptions.toggled ~= nil then self:Set(newOptions.toggled, false) end
		if typeof(newOptions.callback) == "function" then options.callback = newOptions.callback end
		return self
	end
	refresh(false)
	self.modules[#self.modules + 1] = controller
	return controller
end
