function Section:addMultiDropdown(data)
    data=data or {}
    local options={
        title=tostring(data.title or data.Title or "MULTI DROPDOWN"),
        list={}, selected={},
        callback=data.callback or data.Callback or function() end,
        max=tonumber(data.max or data.Max),
    }
    for _,v in ipairs(data.list or data.List or {}) do options.list[#options.list+1]=tostring(v) end
    local defaults=data.default or data.Default or data.selected or data.Selected or {}
    if typeof(defaults)~="table" then defaults={defaults} end
    for _,v in ipairs(defaults) do
        local sv=tostring(v)
        if table.find(options.list,sv) and not table.find(options.selected,sv) then
            options.selected[#options.selected+1]=sv
        end
    end

    local function copySelected()
        local r={}; for i,v in ipairs(options.selected) do r[i]=v end; return r
    end
    local function updateTitle()
        if #options.selected==0 then return options.title
        elseif #options.selected==1 then return options.selected[1]
        elseif #options.selected<=3 then return table.concat(options.selected,", ")
        else return ("%d SELECTED"):format(#options.selected) end
