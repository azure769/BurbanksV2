	section.library = self.library
	section.title = tostring(data.title or data.Title or "SECTION")
	section.modules = {}

	local requestedColumn = data.column or data.Column or data.position or data.Position
	local column

	if requestedColumn == "left" or requestedColumn == "right" or requestedColumn == "full" then
		column = requestedColumn
	else
		-- NeverLose-style automatic section placement:
		-- first unspecified section goes left, next goes right, then alternates.
		local leftCount, rightCount = 0, 0
		for _, existing in ipairs(self.sections) do
			if existing.column == "left" then leftCount += 1 end
			if existing.column == "right" then rightCount += 1 end
