                NeverLose.PlayAnimate(ItemFrame,SlowyTween,{BackgroundTransparency=0.1})
            end)
            signals[#signals+1]=ItemFrame.MouseLeave:Connect(function()
                NeverLose.PlayAnimate(ItemFrame,SlowyTween,{BackgroundTransparency=1})
            end)
            local _,bs=NeverLose:CreateInput(ItemFrame,function()
                options.selected=value; title.Text=value
                setOpen(false); rebuild(); safeCall(options.callback,value)
            end)
            signals[#signals+1]=bs
        end
    end

    header.MouseButton1Click:Connect(function() setOpen(not opened) end)
    rebuild(); setOpen(false)

    local SecureSignal
    NeverLose:CreateInput(header, function()
        if SecureSignal then SecureSignal:Disconnect(); SecureSignal=nil end
        setOpen(true)
        SecureSignal=UserInputService.InputBegan:Connect(function(Input)
            if Input.UserInputType==Enum.UserInputType.MouseButton1 then
                if not NeverLose:IsMouseOverFrame(DropdownHandler) and not NeverLose:IsMouseOverFrame(header) then
                    if SecureSignal then SecureSignal:Disconnect(); SecureSignal=nil end
                    setOpen(false)
                end
            end
        end)
    end)

    local controller={Instance=module,Options=options}
    function controller:Set(value, callCallback)
        value=tostring(value); options.selected=value; title.Text=value
        rebuild(); if callCallback~=false then safeCall(options.callback,value) end
        return self
    end
    function controller:Update(newOptions)
        newOptions=newOptions or {}
        if newOptions.title~=nil then options.title=tostring(newOptions.title); if not options.selected then title.Text=options.title end end
        if typeof(newOptions.list)=="table" then table.clear(options.list); for _,v in ipairs(newOptions.list) do options.list[#options.list+1]=tostring(v) end; rebuild() end
        if newOptions.default~=nil then self:Set(newOptions.default,false) elseif newOptions.selected~=nil then self:Set(newOptions.selected,false) end
        if typeof(newOptions.callback)=="function" then options.callback=newOptions.callback end
        return self
    end
    self.modules[#self.modules+1]=controller
    return controller
end
