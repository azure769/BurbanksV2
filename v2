            end
            if validateKey(candidate) then
                self.keyVerified=true; rememberKey(candidate)
                keyStatus.Text="Access granted."
                bindTheme(self, keyStatus, "TextColor3", "Accent")
                tween_ui(keyCardScale, 0.2, {Scale=0.94}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.wait(0.16)
                if keyOverlay and keyOverlay.Parent then keyOverlay:Destroy() end
                animateMainFromKey()
            else
                keyStatus.Text="Invalid key. Try again."
                bindTheme(self, keyStatus, "TextColor3", "Danger")
                tween_ui(keyCard, 0.06, {Position=UDim2.new(0.5,-7,0.5,0)})
                task.delay(0.07, function()
                    if keyCard and keyCard.Parent then
                        tween_ui(keyCard, 0.08, {Position=UDim2.fromScale(0.5,0.5)})
                    end
                end)
            end
        end

        verifyButton.MouseButton1Click:Connect(submitKey)
        keyInput.FocusLost:Connect(function(enterPressed) if enterPressed then submitKey() end end)

        if self.keyRemember and typeof(readfile)=="function" and typeof(isfile)=="function" then
            local ok,saved = pcall(function()
                if isfile(self.keyFileName) then return readfile(self.keyFileName) end
            end)
            if ok and saved and validateKey(tostring(saved)) then
                self.keyVerified=true; keyOverlay.Visible=false
            end
        end
    end

    -- ── Main window (NeverLose skin) ──────────────────────────────
    local main = create("Frame",{
        Name="Main", Parent=screenGui,
        AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
        Size=UDim2.fromOffset(800,600), BorderSizePixel=0, ClipsDescendants=true,
        Visible=not self.startupMenu and not self.keyEnabled,
    })
    bindTheme(self, main, "BackgroundColor3", "Background")
    main.BackgroundTransparency = 0.055
    corner(main, 10)

    local startupScale = create("UIScale",{Parent=main, Scale=self.uiScale})

    local backgroundImage = create("ImageLabel",{
